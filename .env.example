# Estas duas variáveis não vão num .env local — o build acontece no GitHub
# Actions, então configure-as em GitHub → Settings → Secrets and variables →
# Actions → aba "Variables" → New repository variable. Sem token nenhum
# pra criar: são só as duas abaixo.

# Google Analytics 4 — pega em analytics.google.com → Admin → Fluxos de
# dados → toca no fluxo Web → o código G-XXXXXXXXXX aparece no topo.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Radar Cultural MA — URL do Google Forms (deixe em branco/sem criar a
# variável até o formulário existir; a página mostra um aviso enquanto isso)
NEXT_PUBLIC_RADAR_CULTURAL_FORM_URL=

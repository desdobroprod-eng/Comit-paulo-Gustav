# Google Analytics 4 — Vercel → Project Settings → Environment Variables
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Robô semanal de editais (src/app/api/cron/atualizar-editais)
# CRON_SECRET: mesmo valor configurado em Vercel → Project Settings → Environment Variables
# (a Vercel Cron manda esse valor sozinha no header Authorization; sem ele, a rota fica sem checar auth)
CRON_SECRET=

# GITHUB_TOKEN: fine-grained personal access token só com permissão de
# "Contents: Read and write" neste repositório — é ele que permite o robô
# comitar o editais-auto.json sozinho, sem depender de deploy manual.
GITHUB_TOKEN=
GITHUB_REPO=desdobroprod-eng/Comit-paulo-Gustav
GITHUB_BRANCH=claude/paulo-gustavo-dom-site-1izkpv
